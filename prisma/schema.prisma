// Ceylon IT Tours — application data (users, OAuth links, bookings) and website content
// (tour packages, destinations, experiences, testimonials, blog posts) managed in /admin/content.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

model User {
  id           String   @id @default(uuid())
  name         String
  /// Always stored lower-cased and trimmed, so the unique index is case-insensitive in practice
  email        String   @unique
  phone        String?
  /// bcrypt hash; null for accounts created through Google sign-in
  passwordHash String?
  image        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  accounts       Account[]
  bookings       Booking[]
  historyEntries BookingStatusHistory[]
  reviews        Review[]
  reviewVotes    ReviewVote[]
  wishlist       WishlistItem[]

  @@map("users")
}

/// External identity providers linked to a user (currently Google)
model Account {
  id                String   @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Booking {
  id                  String        @id @default(uuid())
  userId              String
  /// Sanity/local package slug, plus a title snapshot taken at booking time
  packageSlug         String
  packageTitle        String
  customerName        String
  customerEmail       String
  customerPhone       String?
  message             String
  /// Date the customer asked for
  requestedTravelDate DateTime?     @db.Date
  /// Final date set by an admin (initially the requested date)
  travelDate          DateTime?     @db.Date
  status              BookingStatus @default(PENDING)
  /// Latest customer-facing message from the team
  adminMessage        String?
  confirmedAt         DateTime?
  confirmedBy         String?
  cancelledAt         DateTime?
  cancelledBy         String?
  /// Optimistic-concurrency counter: every admin update must match the version it was based on
  version             Int           @default(0)

  /// Bookable option chosen by the customer (null for enquiry-style requests)
  optionId          String?
  /// Option title snapshot taken at booking time
  optionTitle       String?
  /// "HH:MM" start time of the booked slot
  startTime         String?
  /// [{ category, label, count, unitPrice }]
  participants      Json    @default("[]")
  /// Seats this booking holds; counted against the slot capacity while pending or confirmed
  totalParticipants Int     @default(0)
  /// Price quoted at booking time (USD)
  totalPrice        Float?
  /// Payment is collected on the day; online payment comes later
  paymentMethod     String  @default("pay_on_arrival")
  /// Guide language chosen when booking
  language          String?
  /// Hotel / address the customer chose for pickup
  pickupLocation    String?
  /// "HH:MM" pickup time set by the team (pickup planner)
  pickupTime        String?
  /// Special offer applied when booking
  offerName         String?
  discountPercent   Float?
  /// [{ question, answer }]
  answers           Json    @default("[]")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User                   @relation(fields: [userId], references: [id], onDelete: Restrict)
  option   TourOption?            @relation(fields: [optionId], references: [id], onDelete: SetNull)
  history  BookingStatusHistory[]
  review   Review?
  messages BookingMessage[]

  @@index([userId, createdAt])
  @@index([status, travelDate])
  @@index([optionId, travelDate, startTime])
  @@map("bookings")
}

model BookingStatusHistory {
  id          String        @id @default(uuid())
  bookingId   String
  status      BookingStatus
  /// Admin email, or "customer" for the original request
  actorEmail  String
  actorUserId String?
  message     String?
  travelDate  DateTime?     @db.Date
  createdAt   DateTime      @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  actor   User?   @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([bookingId, createdAt])
  @@map("booking_status_history")
}

// ---------------------------------------------------------------------------
// Website content (managed in /admin/content). Only PUBLISHED rows appear on the site.
// Images are stored in Supabase Storage; rows keep the public URL plus alt text and size.
// ---------------------------------------------------------------------------

enum ContentStatus {
  DRAFT
  PUBLISHED
}

model TourPackage {
  id               String        @id @default(uuid())
  /// Short public number shown as "Product ID" on the tour page
  productNumber    Int           @unique @default(autoincrement())
  slug             String        @unique
  status           ContentStatus @default(DRAFT)
  title            String
  /// Short tag shown on the card, e.g. "Transfer tour", "Day trip"
  tourType         String?
  /// Free-text starting point, e.g. "Kandy", "From Kandy"
  location         String?
  /// Slugs of the destinations this tour visits
  destinationSlugs String[]      @default([])
  category         String
  badge            String?
  summary          String
  imageUrl         String
  imageAlt         String        @default("")
  imageWidth       Int?
  imageHeight      Int?

  durationDays     Int?
  durationNights   Int?
  /// Human label for hour-based tours, e.g. "7.5–8 hours"
  durationLabel    String?
  price            Float
  originalPrice    Float?
  groupSize        String   @default("")
  languages        String[] @default([])
  freeCancellation Boolean  @default(false)
  payLater         Boolean  @default(false)
  provider         String?

  description     String?
  highlights      String[] @default([])
  routeSummary    String?
  /// [{ title, detail?, note? }]
  itinerary       Json     @default("[]")
  includes        String[] @default([])
  excludes        String[] @default([])
  notSuitableFor  String[] @default([])
  whatToBring     String[] @default([])
  notAllowed      String[] @default([])
  knowBeforeYouGo String[] @default([])

  rating           Float?
  reviewCount      Int?
  /// [{ label, value }]
  reviewBreakdown  Json    @default("[]")
  aiReviewSummary  String?
  /// [{ name, country, date, rating, text }]
  reviewHighlights Json    @default("[]")

  /// Extra photos shown in the gallery: [{ url, alt, width?, height? }]
  gallery             Json     @default("[]")
  /// "meeting_point" | "pickup" | "both"
  meetingType         String?
  meetingPointName    String?
  meetingPointAddress String?
  meetingLat          Float?
  meetingLng          Float?
  meetingInstructions String?
  /// Hotels or areas where pickup is offered
  pickupAreas         String[] @default([])
  /// "free_24h" | "free_48h" | "free_7d" | "non_refundable" | "custom"
  cancellationPolicy  String?
  cancellationNotes   String?
  /// Questions asked at checkout: [{ question, required? }]
  bookingQuestions    Json     @default("[]")
  /// Search tags, up to 15
  keywords            String[] @default([])
  /// "none" | "included" | "some" | "for_purchase"
  foodIncluded        String?
  foodDetails         String[] @default([])
  /// Main transport used during the activity, e.g. "Tuk tuk", "Train"
  transportTypes      String[] @default([])
  /// "live_guide" | "driver_guide" | "no_guide" | "ticket_only" | "audio_guide"
  guideType           String?
  petFriendly         Boolean  @default(false)
  petPolicy           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  testimonials Testimonial[]

  @@index([status, createdAt])
  @@map("tour_packages")
}

model Destination {
  id            String        @id @default(uuid())
  slug          String        @unique
  status        ContentStatus @default(DRAFT)
  name          String
  region        String        @default("")
  tagline       String        @default("")
  description   String        @default("")
  imageUrl      String
  imageAlt      String        @default("")
  imageWidth    Int?
  imageHeight   Int?
  tourCount     Int           @default(0)
  startingPrice Float         @default(0)
  featured      Boolean       @default(false)
  /// Position on the Sri Lanka map, in % of the map image
  mapX          Float         @default(50)
  mapY          Float         @default(50)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([status])
  @@map("destinations")
}

model Experience {
  id          String        @id @default(uuid())
  slug        String        @unique
  status      ContentStatus @default(DRAFT)
  name        String
  category    String
  description String        @default("")
  imageUrl    String
  imageAlt    String        @default("")
  imageWidth  Int?
  imageHeight Int?
  tourCount   Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status])
  @@map("experiences")
}

model Testimonial {
  id            String        @id @default(uuid())
  status        ContentStatus @default(DRAFT)
  name          String
  country       String        @default("")
  /// Emoji flag, e.g. "🇬🇧"
  countryFlag   String        @default("")
  avatarUrl     String?
  avatarAlt     String        @default("")
  quote         String
  rating        Int           @default(5)
  tourPackageId String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  tourPackage TourPackage? @relation(fields: [tourPackageId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@map("testimonials")
}

model BlogPost {
  id              String        @id @default(uuid())
  slug            String        @unique
  status          ContentStatus @default(DRAFT)
  title           String
  excerpt         String        @default("")
  imageUrl        String
  imageAlt        String        @default("")
  imageWidth      Int?
  imageHeight     Int?
  category        String        @default("")
  readTimeMinutes Int           @default(5)
  publishedAt     DateTime      @default(now())
  /// Article body as plain text (paragraphs separated by blank lines)
  body            String        @default("")
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([status, publishedAt])
  @@map("blog_posts")
}

// ---------------------------------------------------------------------------
// Bookable products: options, pricing and availability (linked to a package by slug,
// so they work whichever content source serves the package), plus customer reviews.
// ---------------------------------------------------------------------------

model TourOption {
  id                   String   @id @default(uuid())
  packageSlug          String
  title                String
  description          String   @default("")
  durationLabel        String?
  languages            String[] @default([])
  pickupIncluded       Boolean  @default(false)
  isPrivate            Boolean  @default(false)
  /// "per_person" | "per_group"
  pricingMode          String   @default("per_person")
  /// Per-person prices: [{ category, label, ageMin?, ageMax?, price }]
  prices               Json     @default("[]")
  /// Per-group prices: [{ minPeople, maxPeople, price }]
  groupTiers           Json     @default("[]")
  /// Seasonal adjustments: [{ name, start (YYYY-MM-DD), end, adjustPercent }]
  seasons              Json     @default("[]")
  minParticipants      Int      @default(1)
  maxParticipants      Int?
  /// Bookings close this many hours before the start time
  cutoffHours          Int      @default(24)
  /// Per start time cut-off overrides: { "08:00": 12 }
  slotCutoffs          Json     @default("{}")
  /// Once a slot has its first booking, keep taking bookings until it starts
  lastMinuteAfterFirst Boolean  @default(false)
  /// Confirm bookings automatically instead of leaving them pending
  instantConfirm       Boolean  @default(false)
  /// "none" | "area" (any address in an area) | "locations" (a fixed list)
  pickupMode           String   @default("none")
  /// Description of the pickup area, e.g. "Any hotel in Kandy city"
  pickupArea           String?
  pickupLocations      String[] @default([])
  /// "at_start" | "before_start"
  pickupTiming         String?
  /// For "before_start": typical minutes before the start time
  pickupMinutesBefore  Int?
  /// "day_before" | "on_booking"
  pickupConfirmation   String?
  wheelchairAccessible Boolean  @default(false)
  skipTheLine          Boolean  @default(false)
  /// e.g. "Audio guide", "Information booklet"
  guideMaterials       String[] @default([])
  active               Boolean  @default(true)
  sortOrder            Int      @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  rules    AvailabilityRule[]
  blocks   AvailabilityBlock[]
  bookings Booking[]

  @@index([packageSlug, sortOrder])
  @@map("tour_options")
}

/// Recurring availability: on the listed weekdays between startDate and endDate, each start time has `capacity` seats
model AvailabilityRule {
  id         String    @id @default(uuid())
  optionId   String
  startDate  DateTime  @db.Date
  /// Open-ended when null
  endDate    DateTime? @db.Date
  /// 0 = Sunday … 6 = Saturday
  weekdays   Int[]     @default([0, 1, 2, 3, 4, 5, 6])
  /// "HH:MM"
  startTimes String[]
  capacity   Int
  createdAt  DateTime  @default(now())

  option TourOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@index([optionId])
  @@map("availability_rules")
}

/// A closed date (or a single closed start time on that date)
model AvailabilityBlock {
  id        String   @id @default(uuid())
  optionId  String
  date      DateTime @db.Date
  /// Null closes the whole day
  startTime String?
  reason    String?
  createdAt DateTime @default(now())

  option TourOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@index([optionId, date])
  @@map("availability_blocks")
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

/// One review per completed booking, shown on the package page once approved
model Review {
  id              String       @id @default(uuid())
  bookingId       String       @unique
  userId          String
  packageSlug     String
  rating          Int
  title           String?
  text            String
  /// Name shown with the review
  authorName      String
  status          ReviewStatus @default(PENDING)
  adminReply      String?
  repliedAt       DateTime?
  /// Reviewer's country, e.g. "United Kingdom"
  country         String?
  /// Browser language when the review was written, e.g. "en" (for "Loved by English speakers")
  language        String?
  /// Optional 1–5 ratings by category
  guideRating     Int?
  transportRating Int?
  valueRating     Int?
  /// Customer photos: [{ url, width?, height? }]
  photos          Json         @default("[]")
  helpfulCount    Int          @default(0)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  booking Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  votes   ReviewVote[]

  @@index([packageSlug, status, createdAt])
  @@map("reviews")
}

/// "Was this helpful?" — one vote per signed-in user per review
model ReviewVote {
  reviewId  String
  userId    String
  createdAt DateTime @default(now())

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([reviewId, userId])
  @@map("review_votes")
}

/// Tours a signed-in user saved with the heart button
model WishlistItem {
  userId      String
  packageSlug String
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, packageSlug])
  @@index([userId, createdAt])
  @@map("wishlist_items")
}

/// Messages between the team and a customer about one booking
model BookingMessage {
  id          String   @id @default(uuid())
  bookingId   String
  /// "team" | "customer"
  sender      String
  senderEmail String
  body        String
  createdAt   DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId, createdAt])
  @@map("booking_messages")
}

/// Discount applied automatically to matching bookings
model SpecialOffer {
  id              String    @id @default(uuid())
  name            String
  /// "early_bird" (book N+ days ahead) | "last_minute" (within N days) | "dates" (travel dates)
  type            String
  discountPercent Float
  /// Empty = every tour
  packageSlugs    String[]  @default([])
  /// early_bird: minimum days ahead; last_minute: maximum days ahead
  days            Int?
  travelFrom      DateTime? @db.Date
  travelTo        DateTime? @db.Date
  active          Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("special_offers")
}

/// Daily page views per tour, for conversion stats
model PackageView {
  packageSlug String
  day         DateTime @db.Date
  count       Int      @default(0)

  @@id([packageSlug, day])
  @@map("package_views")
}
