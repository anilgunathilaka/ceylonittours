# Copy to .env.local (development) or set in your hosting provider (production).
# Placeholders only — never commit real values.

# PostgreSQL connection string (direct TCP URL, e.g. postgresql://user:pass@host:5432/db?sslmode=require)
# Local dev: run `npm run db:dev` and use the TCP URL it prints.
DATABASE_URL=

# Auth.js secret — generate with: npx auth secret
AUTH_SECRET=
# Public site URL in production, e.g. https://ceylonittours.com (used in email links)
AUTH_URL=

# Google OAuth (optional — the Google button is hidden when unset)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Comma-separated admin emails, e.g. owner@ceylonittours.com,ops@ceylonittours.com
ADMIN_EMAILS=

# Resend (optional — bookings still work without it; emails are skipped and logged)
RESEND_API_KEY=
EMAIL_FROM=Ceylon IT Tours <bookings@ceylonittours.com>

# Sanity CMS
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
